---
import LogoIcon from "../assets/Logo.astro";

---

<section id="nosotros" class="relative overflow-hidden min-h-fit flex items-center bg-primary/90">

  <div class="hero-grain absolute inset-0 opacity-[0.08] pointer-events-none"/>
  <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-accent/10 blur-[120px] pointer-events-none"/>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary/20 blur-[140px] pointer-events-none"/>
  <LogoIcon 
    size="700"
    class="absolute -left-24 -z-10 text-primary-soft/15 rotate-45
            drop-shadow-[0_0_50px_rgba(245,240,232,0.12)]
            hover:scale-105 transition-transform duration-700"
  />

  <div class="relative z-10 w-full max-w-[1200px] mx-auto px-8 md:px-12 py-20 md:py-24
              grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-4  items-center">

    <div class="flex flex-col gap-4">
      <p class="text-[clamp(1rem,2vw,1rem)] tracking-[0.3em] uppercase text-base font-light text-shadow-md  ">
        Quiénes somos
      </p>

      <h2 class="font-display leading-[1.0] mb-4 mt-4">
        <p class="block text-[clamp(2rem,5vw,4rem)] italic font-medium text-primary-soft text-shadow-md">
          Salón de belleza
        </p>
        <span class="block text-[clamp(1rem,4vw,3rem)] font-medium tracking-[-0.02em] text-base mt-4 text-shadow-md">
          en Potosí, Bolivia.
        </span>
      </h2>

      <div class="w-14 h-[2px] bg-accent mb-10"/>

      <p class="text-sx text-base/80 leading-[1.9] text-justify w-full md:w-[80%]">
        En <span class="text-base font-medium italic">Le Atelier</span> creemos que cada cabello, rostro y uña
        cuenta una historia. Nuestro equipo de especialistas en Potosí combina técnica europea
        con la calidez boliviana para ofrecerte resultados que te enamoran.
      </p>

    </div>

    <div class="flex flex-col items-center justify-center gap-10 pl-0 md:pl-6">
      <div class="relative flex items-center justify-center">
        <div class="absolute w-75 md:w-95 h-58 md:h-78 rounded-2xl
                    border border-base/12"></div>
        <div class="absolute w-65 md:w-88 h-50 md:h-70 rounded-2xl
                    border border-base/12"></div>
        <div class="w-35 md:w-50 relative z-10 text-accent/90
                   drop-shadow-[0_0_50px_rgba(245,240,232,0.12)]
                   hover:scale-105 transition-transform duration-700">
          <LogoIcon size="full" class="text-accent"/>
        </div>
      </div>

      <blockquote class="text-center font-display italic mt-2
                         text-[clamp(1rem,1.8vw,1.2rem)] text-primary-soft
                         leading-[1.6] max-w-[280px]">
        " Tú traes tu historia.<br />
        <em class="text-base/90 not-italic">Nosotros la hacemos brillar</em> "
      </blockquote>

      <div class="flex items-center gap-4 md:gap-6">
        {[
          { num: '500+', label: 'Clientes' },
          { num: '5★',   label: 'Valoración' },
          { num: '100%', label: 'Dedicación' },
        ].map((s, i) => (
          <div class="flex items-center gap-4 md:gap-6">
            <div class="flex flex-col items-center gap-2">
              <span class="font-display italic text-[1.6rem] md:text-[1.8rem] text-accent leading-none">{s.num}</span>
              <span class="text-[0.56rem] md:text-[0.58rem] tracking-[0.2em] uppercase text-base/90">{s.label}</span>
            </div>
            {i < 2 && <div class="w-[2px] h-10 bg-primary-soft/15"></div>}
          </div>
        ))}
    </div>
      

    </div>
  </div>

</section>