---
import LogoIcon from "../assets/Logo.astro";
---

<footer class="bg-base text-primary-soft pt-16 pb-8 px-8 md:px-10 border-t border-base/10">
  <div class="max-w-[1280px] mx-auto flex flex-wrap items-center justify-between gap-10 pb-10">

    <div class="flex flex-col gap-3">

      <a href="/" class="flex items-center gap-3 group">

        <LogoIcon 
          size="80"
          class="text-primary/70 group-hover:text-primary transition-colors duration-300"
        />

        <div class="flex flex-col ">
          <div class="flex items-baseline gap-1">
            <span class="font-display italic text-lg font-light text-primary group-hover:text-primary transition-colors duration-300">
              Le
            </span>
            <span class="font-display text-xl font-medium tracking-widest uppercase text-primary-soft">
              Atelier
            </span>
          </div>
          <p class="text-[0.72rem] tracking-[0.08em] text-primary max-w-[320px]">
            El arte de la belleza — Potosí, Bolivia
          </p>

        </div>

      </a>


    </div>

    <nav class="flex gap-8 flex-wrap">
      {['#nosotros','#servicios','#galeria','#contacto'].map((href, i) => (
        <a href={href}
           class="text-[0.8rem] tracking-[0.22em] uppercase text-primary
                  hover:text-primary-soft transition-colors duration-300">
          {['Nosotros','Servicios','Galería','Contacto'][i]}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-5">

      <a href="https://instagram.com/atelier.salondebelleza" target="_blank"
         aria-label="Instagram"
         class="text-primary hover:text-primary-soft transition-all duration-300 hover:scale-120 hover:rotate-6">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="2" width="20" height="20" rx="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
        </svg>
      </a>

      <a href="https://wa.me/591XXXXXXXX" target="_blank"
         aria-label="WhatsApp"
         class="text-primary hover:text-primary-soft transition-all duration-300 hover:scale-120 hover:rotate-6">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2C6.58 2 2.16 6.42 2.16 11.88c0 1.91.5 3.77 1.46 5.4L2 22l4.87-1.6a9.8 9.8 0 0 0 5.17 1.45h.01c5.46 0 9.88-4.42 9.88-9.88A9.86 9.86 0 0 0 12.04 2zm0 17.94c-1.62 0-3.21-.43-4.6-1.24l-.33-.2-2.89.95.94-2.82-.21-.34a7.88 7.88 0 0 1-1.2-4.21c0-4.36 3.55-7.91 7.91-7.91a7.9 7.9 0 0 1 7.9 7.91c0 4.36-3.54 7.86-7.89 7.86zm4.35-5.94c-.24-.12-1.4-.69-1.62-.77-.22-.08-.38-.12-.54.12-.16.24-.62.77-.76.93-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.21-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.1-.1.24-.26.36-.39.12-.13.16-.22.24-.37.08-.15.04-.28-.02-.39-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.65.58.25 1.03.4 1.38.51.58.18 1.1.15 1.51.09.46-.07 1.4-.57 1.6-1.12.2-.55.2-1.02.14-1.12-.06-.1-.22-.16-.46-.28z"/>
          </svg>
      </a>

    </div>

  </div>

  <p class="text-center text-[0.68rem] tracking-[0.12em] text-priamry/30">
    © {new Date().getFullYear()} Le Atelier · Todos los derechos reservados
  </p>
</footer>