---
import LogoIcon from "../assets/Logo.astro";

---

<section id="contacto" class="relative py-20 md:py-24 px-8 md:px-12 bg-linear-to-b md:bg-linear-to-br from-primary via-primary/80  to-dark/70 overflow-hidden">
  <div class="hero-grain absolute inset-0 opacity-[0.08] pointer-events-none"/>
  <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-accent/10 blur-[120px] pointer-events-none"/>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary/20 blur-[140px] pointer-events-none"/>
  <LogoIcon 
    size="700"
    class="absolute -right-24 -z-10 text-primary-soft/10 -rotate-45
            drop-shadow-[0_0_50px_rgba(245,240,232,0.12)]
            hover:scale-105 transition-transform duration-700"
  />


  <div class="max-w-[1280px] mx-auto relative z-10">


    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div class="flex flex-col">
        <div class="mb-10">
          <p class="text-[clamp(1rem,2vw,1rem)] tracking-[0.3em] uppercase text-base font-light text-shadow-md mb-10  ">
            Encuéntranos
          </p>
  
          <h2 class="flex gap-2 font-display leading-[1.1] text-[clamp(2rem,5vw,4rem)] text-base text-shadow-md">
            Visítanos <span class="block text-[clamp(2rem,5vw,4rem)] italic text-primary-soft"> en Potosí </span>
            
          </h2>
          <div class="w-14 h-[2px] bg-accent mt-8"/>
        </div>
  
        <div class="flex flex-col gap-10">
  
          <p class="text-sx text-base leading-[1.9] max-w-[480px] font-light">
            Estamos listos para recibirte. Agenda tu cita o visítanos y vive una experiencia pensada en cada detalle.
          </p>
  
          <div class="flex flex-col gap-6">
  
            {[
              { label: 'Ubicación',  value: 'Calle Hoyos 12, Potosí, Bolivia' },
              { label: 'Horarios',   value: 'Lun – Sáb · 9:00 – 19:00' },
              { label: 'Instagram',  value: '@atelier.salondebelleza', link: 'https://instagram.com/atelier.salondebelleza' },
              { label: 'Facebook',   value: 'Le Atelier Salón', link: 'https://facebook.com' },
            ].map(item => (
              <div class="group flex items-start gap-4">
  
                <div class="w-6 h-px bg-accent/30 mt-3 group-hover:w-10 group-hover:bg-accent transition-all duration-400"></div>
  
                <div>
                  <span class="block text-[0.7rem] tracking-[0.25em] uppercase text-accent mb-1">
                    {item.label}
                  </span>
  
                  {item.link ? (
                    <a href={item.link} target="_blank"
                      class="text-[0.95rem] text-base hover:text-primary-soft transition-colors duration-300">
                      {item.value}
                    </a>
                  ) : (
                    <span class="text-[0.95rem] text-base">
                      {item.value}
                    </span>
                  )}
                </div>
  
              </div>
            ))}
  
          </div>
  
  
  
        </div>

      </div>

      <div class="flex flex-col h-full"> 
        <div class="relative w-[90%] min-h-[50vh] group m-auto">

          <div class="absolute inset-0 rounded-xl bg-accent/50 blur-[40px] opacity-0 group-hover:opacity-100 transition-opacity duration-500"/>

          <div class="relative overflow-hidden rounded-md border border-base/20 h-full shadow-md">

            <iframe
              src="https://maps.google.com/maps?q=-19.588778546267445,-65.75188693695773&z=17&output=embed"
              style="border:0;"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full h-full grayscale opacity-80
                      group-hover:grayscale-0 group-hover:opacity-100
                      transition-all duration-700"
            ></iframe>

          </div>

        </div>
        <div class="flex flex-wrap gap-6 mt-1 mx-auto">

          <a
            href="https://wa.me/591XXXXXXXX?text=Hola!%20Quisiera%20reservar%20una%20cita"
            target="_blank"
            class="text-[0.72rem] tracking-[0.25em] uppercase font-medium px-8 py-3.5
                   bg-primary-soft text-base border border-primary
                   hover:scale-105 hover:brightness-110
                   transition-all duration-300"
          >
            Reservar cita
          </a>

          <a
            href="https://instagram.com/atelier.salondebelleza"
            target="_blank"
            class="text-[0.72rem] tracking-[0.25em] uppercase font-medium px-8 py-3.5
                   border border-base/40 text-base bg-primary/70
                   hover:border-base hover:text-base hover:scale-105
                   transition-all duration-300"
          >
            Ver Instagram
          </a>

        </div>
      </div>

    </div>
  </div>
</section>