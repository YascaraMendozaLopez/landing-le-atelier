---
import LogoIcon from "../assets/Logo.astro";
const links = [
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#galeria', label: 'Galería' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header id="navbar" class="fixed top-0 left-0 w-full z-50 transition-all duration-500">

  <div class="max-w-[1280px] mx-auto px-8 md:px-10 py-5 flex items-center justify-between gap-8">

    <a href="/" class="flex items-center gap-1.5">
      <LogoIcon class="text-primary mr-2" size="60"/>
      <span class="font-display italic text-xl font-medium text-primary text-shadow-2xs">Le</span>
      <span class="font-display text-lg font-semibold tracking-widest uppercase text-primary-soft text-shadow-2xs">Atelier</span>
    </a>

    <nav class="hidden md:flex gap-10">
      {links.map(l => (
        <a
          href={l.href}
          class="text-[0.75rem] tracking-[0.18em] uppercase font-medium text-dark relative pb-0.5
                 after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-primary
                 after:transition-all after:duration-300 text-shadow-md
                 hover:text-primary hover:after:w-full transition-colors duration-300"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <a
      href="#contacto"
      class="hidden md:inline-block text-[0.72rem] tracking-[0.2em] uppercase font-medium
             text-base bg-primary px-6 py-2.5 shadow-md
             hover:bg-primary-soft hover:scale-105
             transition-all duration-300"
    >
      Reservar
    </a>

    <button id="burger" aria-label="Menú" class="md:hidden flex flex-col gap-1.5 p-1">
      <span id="b1" class="block w-6 h-px bg-primary-soft transition-all duration-300 origin-center"></span>
      <span id="b2" class="block w-6 h-px bg-primary-soft transition-all duration-300 origin-center"></span>
    </button>
  </div>

  <div
    id="mobileMenu"
    class="md:hidden overflow-hidden transition-all duration-400 bg-base backdrop-blur-md h-0"
  >
    <div class="px-8 pb-10 pt-8 flex flex-col h-full">
      <div class="flex flex-col gap-8">
        {links.map(link => (
          <a href={link.href} class="mobile-link py-3 text-[0.78rem] tracking-[0.2em] uppercase text-dark/80 border-b border-primary/20 text-center">
            {link.label}
          </a>
        ))}
      </div>
      <a href="#contacto" class="mobile-link mt-16 text-center py-3.5 shadow-md bg-primary-soft text-base text-[0.72rem] tracking-[0.2em] uppercase font-medium">
        Reservar cita
      </a>
    </div>
  </div>

</header>

<script>
  const navbar = document.getElementById('navbar');
  const burger = document.getElementById('burger');
  const menu   = document.getElementById('mobileMenu');
  const b1     = document.getElementById('b1');
  const b2     = document.getElementById('b2');
  let open = false;

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      navbar?.classList.add('bg-base', 'backdrop-blur-md', 'shadow-[0_1px_0_rgba(0,0,0,0.05)]');
    } else {
      navbar?.classList.remove('bg-base', 'backdrop-blur-md', 'shadow-[0_1px_0_rgba(0,0,0,0.05)]');
    }
  });

  burger?.addEventListener('click', () => {
    open = !open;

    if (open) {
      menu?.classList.remove('h-0');
      menu?.classList.add('h-screen');
    } else {
      menu?.classList.remove('h-screen');
      menu?.classList.add('h-0');
    }

    b1!.style.transform = open ? 'translateY(3.5px) rotate(45deg)' : '';
    b2!.style.transform = open ? 'translateY(-3.5px) rotate(-45deg)' : '';
  });

  document.querySelectorAll('.mobile-link').forEach(a => {
    a.addEventListener('click', () => {
      open = false;
      menu?.classList.remove('h-screen');
      menu?.classList.add('h-0');
      b1!.style.transform = '';
      b2!.style.transform = '';
    });
  });
</script>